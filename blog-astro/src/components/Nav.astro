---
import { nav, site } from '../data/site';
import DynamicIsland from './DynamicIsland.astro';

const path = Astro.url.pathname;
const current = path === '/' ? '#top' : path;
---

{/*
  结构说明：模仿参考站 bad0rang3.xyz —— 外层的 .nav 只是一个高度为 0 的定位锚点
  （pointer-events: none），真正可见的三块各自绝对定位：
    · 灵动岛   顶部正中（展开时向两侧生长，见 styles/island.css）
    · 品牌     左上
    · 导航+操作 右上胶囊
  岛展开时（island.css 的 `.music-island[data-open=true] ~ .nav__cluster`）右上胶囊会自动淡出让位，
  所以岛长到 430px 也不会压住任何东西；1100px 以下导航链接收进下拉菜单。
*/}
<header class="nav" id="siteNav" data-nav>
  <a class="nav__brand" href="#top" aria-label="回到顶部">
    <span class="dot" aria-hidden="true"></span>
    {site.handle}<span aria-hidden="true">/</span>STUDIO
  </a>

  <DynamicIsland />

  <div class="nav__cluster">
    <nav class="nav__links" id="navLinks" aria-label="主导航">
      {nav.map((item) => (
        <a
          class="nav__link"
          href={item.href}
          aria-current={current === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="切换深浅色主题"
        title="切换主题"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button class="nav__toggle" id="navToggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="navLinks">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" />
        </svg>
      </button>
    </div>
  </div>
</header>
