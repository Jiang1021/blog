---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, stats, marquee, works, worksLede, about, posts, notes, presence, socials } from '../data/site';
---

<BaseLayout>
    <Nav />

  <main id="main">
    <!-- ============ 01 · HERO ============ -->
    <section class="hero" id="top" data-hero>
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="hero__spot" data-hero-spot aria-hidden="true"></div>

      <div class="wrap hero__inner">
        <div class="hero__grid">
          <div>
            <p class="eyebrow hero__eyebrow" data-enter style="--i:0">
              <span>{site.role}</span>
              <span>· since {site.since}</span>
            </p>

            <h1 class="display hero__title" data-enter style="--i:1">
              <span class="hero__name">{site.handle}</span>
              <span class="hero__cn">{site.cn} · 个人实验室</span>
            </h1>

            <p class="lede" data-enter style="--i:2">
              {site.tagline}
            </p>

            <div class="hero__actions" data-enter style="--i:3">
              <a class="btn btn--solid" href="#posts">
                读点文章
                <svg class="btn__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a class="btn" href="#about">关于我</a>
            </div>
          </div>

          <aside class="hero__side" data-enter style="--i:4">
            <div class="term">
              <div>$ whoami</div>
              <div><b>{site.handle}</b> · {site.role}</div>
              <div>$ uptime</div>
              <div><b>since {site.since}</b> · {stats[2].num}{stats[2].suffix} years</div>
              <div>$ cat focus.txt</div>
              <div><b>{site.focus}</b></div>
              <div>$ <span class="caret" aria-hidden="true"></span></div>
            </div>
          </aside>
        </div>

        <dl class="hero__stats" data-enter style="--i:5">
          {stats.map((s) => (
            <div class="hero__stat">
              <dt>{s.label}</dt>
              <dd><strong>{s.num}</strong>{s.suffix}</dd>
            </div>
          ))}
        </dl>
      </div>

      <span class="scroll-cue" aria-hidden="true"><i></i>SCROLL</span>
    </section>

    <!-- ============ 02 · MARQUEE ============ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[...marquee, ...marquee].map((word) => <span>{word}</span>)}
      </div>
    </div>

    <!-- ============ 03 · WORK ============ -->
    <section class="section" id="work">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="eyebrow" data-enter style="--i:0">Selected / {String(works.length).padStart(2, '0')}</p>
            <h2 class="h2" data-enter style="margin-top:1rem;--i:1">项目与实验</h2>
            <p class="lede" style="max-width:46ch;margin-top:.9rem">
              {worksLede}
            </p>
          </div>
          <a class="btn" href="#work">
            全部项目
            <svg class="btn__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </header>

        <div class="bento">
          {works.map((w, i) => (
            <a
              class:list={['card', 'spot', 'ticked', 'work', w.span === 'wide' && 'work--wide', w.placeholder && 'work--empty']}
              href="#work"
              data-reveal
              data-spot
              style={`--d:${i}`}
            >
              <div class="work__top">
                <span class="work__idx">{w.idx}</span>
                <span class="work__badge">{w.badge}</span>
              </div>
              <h3 class="work__title">{w.title}</h3>
              <p class="work__desc">{w.desc}</p>
              <div class="work__tags">
                {w.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              <span class="work__go">
                查看详情
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 04 · JOURNAL ============ -->
    <section class="section" id="posts">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="eyebrow" data-enter style="--i:0">Journal / {String(posts.length).padStart(2, '0')}</p>
            <h2 class="h2" data-enter style="margin-top:1rem;--i:1">最近更新</h2>
          </div>
          <a class="btn" href="#posts">
            全部文章
            <svg class="btn__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </header>

        <div class="posts">
          {posts.map((p, i) => (
            <a class:list={['post', p.placeholder && 'post--empty']} href="#posts" data-reveal style={`--d:${i}`}>
              <span class="post__date">{p.date}</span>
              <span class="post__title">{p.title}</span>
              <span class="post__meta">
                <span class="tag">{p.tag}</span>
                <span class="post__len">{p.len}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 05 · NOTES ============ -->
    <section class="section" id="notes">
      <div class="wrap">
        <header class="section-head">
          <div>
            <p class="eyebrow" data-enter style="--i:0">Notes</p>
            <h2 class="h2" data-enter style="margin-top:1rem;--i:1">碎碎念</h2>
          </div>
          <p class="mono" style="color:var(--text-3)">不写成长文的想法，一行一条</p>
        </header>

        <ul class="notes">
          {notes.map((n, i) => (
            <li class="note" data-reveal style={`--d:${i}`}>
              <span class="note__date">{n.date}</span>
              <span class="note__text">{n.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ 06 · PRESENCE ============ -->
    <section class="section section--tight">
      <div class="wrap">
        <div class="presence">
          <article class="card spot ticked presence__card" data-spot data-reveal style="--d:0">
            <div class="presence__row presence__id">
              <div style="display:flex;gap:.85rem;align-items:center">
                <span class="presence__art" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 4.5-1.4 4.5-5.9a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C7.5 1.6 6.4 1.9 6.4 1.9a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 5 8.3c0 4.5 1.7 5.6 4.5 5.9-.4.4-.6.9-.6 1.5V19"/></svg>
                </span>
                <div>
                  <p class="mono" style="color:var(--text-3);font-size:.68rem">GitHub</p>
                  <p style="font-weight:600">@{presence.github.user}</p>
                </div>
              </div>
              <span class="mono" style="color:var(--text-3);font-size:.68rem">public</span>
            </div>
            <div class="presence__row presence__stats">
              <div class="mini"><strong data-count={presence.github.repos}>0</strong><span>仓库</span></div>
              <div class="mini"><strong data-count={presence.github.followers}>0</strong><span>关注者</span></div>
              <div class="mini"><strong data-count={presence.github.commits}>0</strong><span>提交</span></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ 07 · ABOUT ============ -->
    <section class="section" id="about">
      <div class="wrap about">
        <div>
          <p class="eyebrow" data-enter style="--i:0">About</p>
          <h2 class="h2" data-enter style="margin-top:1rem;--i:1">
            {about.title}
          </h2>
        </div>
        <div class="about__body">
          {about.paragraphs.map((text, i) => (
            <p data-reveal style={`--d:${i}`} set:html={text} />
          ))}
          <dl class="about__facts" data-reveal style={`--d:${about.paragraphs.length}`}>
            {about.facts.map((f) => (
              <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ 08 · CONTACT ============ -->
    <section class="section" id="contact">
      <div class="wrap contact">
        <div>
          <p class="eyebrow" data-enter style="--i:0">Contact</p>
          <h2 class="h2 contact__title" style="margin-top:1rem" data-enter style="--i:1">想聊点什么？</h2>
          <p class="lede" style="max-width:44ch;margin-top:1rem">
            技术、工具、或者只是想吐槽一下今天写的 bug —— 都欢迎。
          </p>
          <div class="socials">
            {socials.map((s, i) => (
              <a class="social" href={s.href} data-reveal style={`--d:${i}`}>
                {s.label}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </a>
            ))}
          </div>
        </div>

        <aside class="mailbox card" data-reveal style="--d:0">
          <p class="mono" style="color:var(--text-3);font-size:.68rem">MAIL</p>
          <a class="mailbox__addr" href={`mailto:${site.email}`} data-copy={site.email}>{site.email}</a>
          <p class="mono mailbox__hint" data-copy-hint>点击复制</p>
        </aside>
      </div>

      <p class="wrap easter" data-easter aria-hidden="true">
        <span aria-hidden="true">✦</span> 你读到页尾了，谢谢 —— 去写点自己的东西吧。
      </p>
    </section>
  </main>

  <Footer />

  <script>
    /* ---------- 主题切换 ---------- */
    const root = document.documentElement;
    const toggle = document.getElementById('themeToggle');
    toggle?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('blog-theme', next); } catch {}
    });

    /* ---------- 顶栏移动端菜单 ---------- */
    const navToggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    navToggle?.addEventListener('click', () => {
      const open = navLinks?.classList.toggle('is-open') ?? false;
      navToggle.setAttribute('aria-expanded', String(open));
    });
    navLinks?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        navLinks.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      }
    });

    /* ---------- Hero 鼠标聚光（rAF 节流） ---------- */
    const hero = document.querySelector('[data-hero]');
    const spot = document.querySelector('[data-hero-spot]');
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (hero && spot && fine) {
      let queued = false;
      let mx = 0, my = 0;
      hero.addEventListener('pointermove', (e) => {
        const r = (hero as HTMLElement).getBoundingClientRect();
        mx = ((e as PointerEvent).clientX - r.left) / r.width * 100;
        my = ((e as PointerEvent).clientY - r.top) / r.height * 100;
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          (spot as HTMLElement).style.setProperty('--mx', mx + '%');
          (spot as HTMLElement).style.setProperty('--my', my + '%');
          queued = false;
        });
      }, { passive: true });
    }

    /* ---------- 卡片聚光 ---------- */
    document.querySelectorAll<HTMLElement>('[data-spot]').forEach((card) => {
      if (!fine) return;
      let queued = false;
      let x = 0, y = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        x = e.clientX - r.left;
        y = e.clientY - r.top;
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          card.style.setProperty('--mx', x + 'px');
          card.style.setProperty('--my', y + 'px');
          queued = false;
        });
      }, { passive: true });
    });

    /* ---------- 滚动 reveal ---------- */
    const revealables = document.querySelectorAll('[data-reveal]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      revealables.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      revealables.forEach((el) => io.observe(el));
    }

    /* ---------- 数字滚动 ---------- */
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    counters.forEach((el) => {
      const target = Number(el.dataset.count || 0);
      if (reduce) { el.textContent = String(target); return; }
      let started = false;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || started) return;
          started = true;
          const t0 = performance.now();
          const dur = 1100;
          const tick = (now: number) => {
            const p = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          io.unobserve(el);
        });
      }, { threshold: 0.5 });
      io.observe(el);
    });

    /* ---------- 巧思：点击邮箱复制 + sparkle ---------- */
    const copyTarget = document.querySelector<HTMLElement>('[data-copy]');
    const copyHint = document.querySelector<HTMLElement>('[data-copy-hint]');
    copyTarget?.addEventListener('click', async () => {
      const text = copyTarget.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (copyHint) {
        copyHint.textContent = '已复制 ✦';
        copyHint.style.color = 'var(--accent)';
        window.setTimeout(() => {
          copyHint.textContent = '点击复制';
          copyHint.style.color = '';
        }, 1800);
      }
      const spark = document.createElement('span');
      spark.className = 'spark';
      spark.textContent = '✦';
      copyTarget.appendChild(spark);
      window.setTimeout(() => spark.remove(), 700);
    });

    /* ---------- 巧思：页尾彩蛋 ---------- */
    const easter = document.querySelector<HTMLElement>('[data-easter]');
    if (easter) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) easter.classList.add('is-in');
        });
      }, { threshold: 0.6 });
      io.observe(easter);
    }
  </script>

  <style>
    /* ---- Notes ---- */
    .notes { border-top: 1px solid var(--line); }
    .note {
      display: grid;
      grid-template-columns: 108px minmax(0, 1fr);
      gap: 1.25rem;
      padding-block: 1rem;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    .note__date {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-3);
      letter-spacing: 0.06em;
    }
    .note__text { color: var(--text-2); }

    /* ---- Presence mini stats ---- */
    .mini {
      flex: 1;
      border-left: 1px solid var(--line);
      padding-left: 0.75rem;
    }
    .mini:first-child { border-left: 0; padding-left: 0; }
    .mini strong {
      display: block;
      font-size: 1.15rem;
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.02em;
    }
    .mini span {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-3);
    }

    /* ---- About ---- */
    .about {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }
    .about__body { display: grid; gap: 1.15rem; }
    .about__body p { color: var(--text-2); max-width: 58ch; }
    .about__body strong { color: var(--text); font-weight: 600; }
    .about__facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--r);
      overflow: hidden;
      margin-top: 0.5rem;
    }
    .about__facts > div { background: var(--surface); padding: 1rem 1.15rem; }
    .about__facts dt {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-3);
      margin-bottom: 0.3rem;
    }
    .about__facts dd { font-size: 0.92rem; }

    /* ---- Contact ---- */
    .contact {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .mailbox { display: grid; gap: 0.4rem; align-content: center; }
    .mailbox__addr {
      font-family: var(--font-mono);
      font-size: clamp(0.95rem, 2vw, 1.15rem);
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      width: fit-content;
      border-bottom: 1px solid var(--line-strong);
      transition: color 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
    }
    .mailbox__addr:hover { color: var(--accent); border-color: var(--accent); }
    .mailbox__hint { color: var(--text-3); font-size: 0.66rem; transition: color 0.2s var(--ease-out); }
    .spark {
      position: absolute;
      right: -1.1rem;
      top: -0.7rem;
      color: var(--accent);
      animation: spark 0.7s var(--ease-out) forwards;
      pointer-events: none;
    }
    @keyframes spark {
      0% { opacity: 0; transform: scale(0.4) translateY(4px); }
      40% { opacity: 1; transform: scale(1.15) translateY(-2px); }
      100% { opacity: 0; transform: scale(0.9) translateY(-14px); }
    }

    /* ---- Easter egg ---- */
    .easter {
      margin-top: 3.5rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      color: var(--text-3);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
    }
    .easter.is-in { opacity: 1; transform: none; }
    .easter span { color: var(--accent); }

    @media (max-width: 900px) {
      .about, .contact { grid-template-columns: minmax(0, 1fr); }
      .note { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; }
    }
  </style>
</BaseLayout>
